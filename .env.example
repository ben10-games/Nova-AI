# Syntaz AI server configuration — copy to .env.local (local) or set in your host's
# environment settings (production). All values are SERVER-SIDE ONLY.
# Never prefix them with NEXT_PUBLIC_ and never commit real values.

# ---------------------------------------------------------------------------
# AI provider (any OpenAI-compatible API: LM Studio, vLLM, Ollama, OpenRouter,
# Together, OpenAI, ...)
# ---------------------------------------------------------------------------

# Base URL ending in /v1. REQUIRED in production.
# Local LM Studio example: http://127.0.0.1:1234/v1
AI_BASE_URL=https://your-provider.example.com/v1

# API key, sent as "Authorization: Bearer <key>". Leave empty for LM Studio.
AI_API_KEY=

# "lmstudio" (adds loaded-model detection) or "openai-compatible".
AI_PROVIDER=openai-compatible

# Name shown in the UI, e.g. "LM Studio" or "My AI provider".
AI_PROVIDER_NAME=

# Fixed model ID. If set, users cannot pick other models.
# Leave empty to discover models from the provider's /models endpoint.
AI_MODEL=

# Optional comma-separated allowlist of model IDs users may pick in Settings.
AI_MODELS=

# Optional system prompt (users can override it in Settings -> Custom instructions).
AI_SYSTEM_PROMPT=

# Optional: context window in tokens, used to trim long chats when the
# provider does not report it (LM Studio reports it automatically).
AI_CONTEXT_LENGTH=

# Optional: hard cap on tokens per reply (strongly recommended for paid APIs).
AI_MAX_OUTPUT_TOKENS=2048

# Optional: "none", "minimal", "low", "medium" or "high", sent as reasoning_effort.
# "none" turns off Gemini's slow "thinking" (much faster for Syntaz); leave empty for LM Studio.
AI_REASONING_EFFORT=
# Max milliseconds to wait for the provider to start replying.
AI_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------

# Chat requests per client per window (0 disables) and window length in ms.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Simultaneous replies per client (0 disables).
RATE_LIMIT_CONCURRENT=2

# Set to true ONLY when running behind a reverse proxy / hosting platform that
# sets X-Forwarded-For; otherwise all visitors share one rate-limit bucket.
TRUST_PROXY=false

# Optional site-wide login (HTTP Basic auth). Set BOTH to enable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Syntaz Actions (goal -> plan -> tools). All tools run on the SERVER.
# ---------------------------------------------------------------------------

# Set to false to turn Syntaz Actions off entirely.
NOVA_ACTIONS_ENABLED=true

# Folder the file tools may access (absolute, or relative to where the server
# starts). Leave empty to disable file tools. In production this is a folder on
# the SERVER's disk that every user of the site can read through Syntaz.
# Demo: ./examples/workspace
WORKSPACE_DIR=

# Allow the create_file tool. Every write still requires explicit approval in
# the UI. Existing files are never modified, moved or deleted.
WORKSPACE_ALLOW_WRITES=false

# "json" (structured JSON output, works with most local models) or
# "native" (OpenAI tool calls, for models/providers that support them).
AI_AGENT_MODE=json

# Max tool steps per task, and timeouts.
AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_MS=60000
AGENT_APPROVAL_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) for Syntaz Actions
# ---------------------------------------------------------------------------
# Comma-separated IDs of TRUSTED MCP servers to enable. Servers (fixed command
# and script) are defined in src/lib/config.ts; unknown IDs are ignored.
# Currently available: nova-test (harmless local test server, stdio).
# Every MCP tool call requires explicit approval in the UI.
MCP_SERVERS=

# Per-call timeout and connection/discovery timeout (milliseconds).
MCP_TOOL_TIMEOUT_MS=20000
MCP_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Blender (optional MCP server "blender"; add it to MCP_SERVERS to enable)
# Requires the Syntaz Blender Bridge add-on (blender-addon/nova_blender_bridge.py)
# running in Blender. The bridge listens on 127.0.0.1 only.
# ---------------------------------------------------------------------------
# Bridge port (must match the add-on preference; default 9890).
NOVA_BLENDER_PORT=9890
# Absolute path of the token file the add-on writes when you press Start.
# Default: ~/.config/nova-blender/token
NOVA_BLENDER_TOKEN_FILE=
# Per-call timeout for Blender tools (renders can be slow).
MCP_BLENDER_TOOL_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Chrome browser control (optional MCP server "browser"; add it to MCP_SERVERS)
# Requires the Syntaz Browser Bridge extension (chrome-extension/), loaded unpacked.
# The bridge listens on 127.0.0.1 only and accepts only that extension + the pairing code.
# ---------------------------------------------------------------------------
# WebSocket port the extension connects to (must match the port in the side panel's Settings).
NOVA_BROWSER_PORT=9895
# Pairing-code file (created automatically, mode 600). Default: ~/.config/nova-browser/token
NOVA_BROWSER_TOKEN_FILE=
# Search page used by the search_web tool (the query is appended URL-encoded; https only).
# Default: https://html.duckduckgo.com/html/?q=
NOVA_BROWSER_SEARCH_URL=

# ---------------------------------------------------------------------------
# Debugging (optional)
# ---------------------------------------------------------------------------
# Log how long each Syntaz Actions model call takes and how many tokens it reads/writes (no content).
NOVA_DEBUG_LLM=
# Print the full Syntaz Actions system prompt once per task (to the server log).
NOVA_DEBUG_PROMPT=
